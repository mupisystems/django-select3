include README.md
include LICENSE
include pyproject.toml

recursive-include django_select3 *.py
recursive-include django_select3/templates *
recursive-include django_select3/static *

global-exclude __pycache__
global-exclude *.py[cod]

prune venv
prune .venv
prune __pycache__
prune .pytest_cache
prune assets
prune tests
prune .git
prune .github
prune .vscode
prune .idea
